# sdist : de quoi reconstruire le module compilé et sa libblosc2 depuis les sources
include CHANGELOG.rst LICENSE*.rst README.rst
include rapidjson/version.txt rapidjson/blosc2_determinisme.patch rapidjson/pgo_workload.py rapidjson/libsodium_statique.py
recursive-include rapidjson *.h
include scripts/construit_libblosc2_serializejson.sh
# construits sur la machine de développement, jamais distribués
global-exclude *.so
# un greffon de fichiers git (setuptools_scm) ajouterait tout le dépôt :
# ces dossiers ne servent ni à construire ni à utiliser le paquet
prune Notes
prune images_benchmarks
prune docs
prune docs_source
prune tests
prune .github
exclude my_list.json requirements.txt Makefile make.bat CLAUDE.md .directory .hgignore .ignore
