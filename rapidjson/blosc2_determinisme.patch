+  int32_t commit_nblock;
+  blosc2_pthread_cond_t commit_cv;
 };
 
 struct blosc_job_queue_entry {
@@ -4879,6 +4884,7 @@ static void t_blosc_do_job(void *ctxt) {
   if (ensure_thread_context_capacity(thcontext, context) < 0) {
     blosc2_pthread_mutex_lock(&job->mutex);
     job->giveup_code = BLOSC2_ERROR_MEMORY_ALLOC;
+    blosc2_pthread_cond_broadcast(&job->commit_cv);
     blosc2_pthread_mutex_unlock(&job->mutex);
     goto job_done;
   }
@@ -4969,22 +4975,36 @@ static void t_blosc_do_job(void *ctxt) {
       if (job->giveup_code > 0) {
         job->giveup_code = cbytes;
       }
+      blosc2_pthread_cond_broadcast(&job->commit_cv);
       blosc2_pthread_mutex_unlock(&job->mutex);
       break;
     }
 
     blosc2_pthread_mutex_lock(&job->mutex);
     if (compress && !memcpyed) {
+      /* SMARTOS : attend son tour pour coller le bloc — la compression est
+         restée parallèle, seul le COMMIT est ordonné par indice de bloc,
