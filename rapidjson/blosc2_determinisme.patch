       }
       if ((cbytes == 0) || (ntdest + cbytes > maxbytes)) {
         job->giveup_code = 0;
+        blosc2_pthread_cond_broadcast(&job->commit_cv);
         blosc2_pthread_mutex_unlock(&job->mutex);
         break;
       }
       job->output_bytes += cbytes;
+      job->commit_nblock = nblock_ + 1;
+      blosc2_pthread_cond_broadcast(&job->commit_cv);
       blosc2_pthread_mutex_unlock(&job->mutex);
