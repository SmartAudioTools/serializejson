def test_json_encode_bytes_b64():\par
    bytes_ = b'A'*9000000                            # 1.7 msec       \par
    bytes_b64 = pybase64.b64encode(bytes_)           # 3.3 msec (time of a copy)\par
    str_ = bytes.decode(bytes_b64)                   # 3.5 msec (time of a copy)\par
    \par
    json_str_manual = f'"\{str_\}"'                    # 3.5 msec (time of a copy)\par
    json_str_rapidjson = rapidjson.dumps(str_,ensure_ascii = False)   # 32 msec with rapidjson (9 x time of a copy !) due to escaping \\t \\n \\r " and \\ ? not need to escape ther is only b64 characters\par
    json_str_rawjson = rapidjson.dumps(rapidjson.RawJSON(json_str_manual),ensure_ascii = False)# 40 msec (11 x time of a copy !) ther is no characters to escape ! \par
    \par
    json_bytes_manual = b'"%b"'%str_.encode("utf-8")  # 8  msec (time of 2 copy)\par
    bytesIO = io.BytesIO()\par
    rapidjson.dump(str_,bytesIO,ensure_ascii = False)   # 76 msec with rapidjson (29 x time of a copy !) due to escaping \\t \\n \\r " and \\ ?\par
    bytesIO.seek(0)\par
    json_bytes_rapidjson = bytesIO.read()\par
    \par
    assert json_str_manual == json_str_rapidjson\par
    assert json_str_manual == json_str_rawjson\par
    assert json_bytes_manual == json_bytes_rapidjson\par
