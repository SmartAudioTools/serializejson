{\field{\*\fldinst{HYPERLINK "https://github.com/python/cpython/blob/main/Objects/unicodeobject.c"}}{\fldrslt{\ul\cf1 https://github.com/python/cpython/blob/main/Objects/unicodeobject.c}}}\f0\fs22\par
PyUnicode_AsUTF8AndSize\par
\pard\li2160\sl240\slmult1 retourne un pointeur vers version utf_8 si a d\'e9j\'e0 \'e9t\'e9 encod\'e9 \par
sinon il remplit avec unicode_fill_utf8\fs16\par
\par
const char *\par
PyUnicode_AsUTF8AndSize(PyObject *unicode, Py_ssize_t *psize)\par
\{\par
    if (!PyUnicode_Check(unicode)) \{\par
        PyErr_BadArgument();\par
        return NULL;\par
    \}\par
\par
    if (\ul PyUnicode_UTF8(unicode)\ulnone  == NULL) \{\par
        if (\ul unicode_fill_utf8(unicode\ulnone ) == -1) \{\par
            return NULL;\par
        \}\par
    \}\par
\par
    if (psize)\par
        *psize = PyUnicode_UTF8_LENGTH(unicode);\par
    return PyUnicode_UTF8(unicode);\par
\}\par
\par
\par
\fs22 PyUnicode_UTF8(unicode)\par
\pard\li2880\sl240\slmult1 retourne un pointeur vers version utf_8 si a d\'e9j\'e0 \'e9t\'e9 encod\'e9 ou simple ASCII \par
\fs16 #define PyUnicode_UTF8(op)                              \\\par
    (assert(_PyUnicode_CHECK(op)),                      \\\par
     PyUnicode_IS_COMPACT_ASCII(op) ?                   \\\par
         \ul ((char*)(_PyASCIIObject_CAST(op) + 1\ulnone )) :       \\\par
         \ul _PyUnicode_UTF8(op))\ulnone\par
\par
#define _PyUnicode_UTF8(op)                             \\\par
    \ul (_PyCompactUnicodeObject_CAST\ulnone (op)->utf8)\par
\par
\fs22 _PyCompactUnicodeObject_CAST\par
\par
\pard\li2160\sl240\slmult1 unicode_fill_utf8\par
\pard\li2880\sl240\slmult1\fs16\par
static int\par
unicode_fill_utf8(PyObject *unicode)\par
\{\par
    /* the string cannot be ASCII, or PyUnicode_UTF8() would be set */\par
    assert(!PyUnicode_IS_ASCII(unicode));\par
\par
    int kind = PyUnicode_KIND(unicode);\par
    const void *data = PyUnicode_DATA(unicode);\par
    Py_ssize_t size = PyUnicode_GET_LENGTH(unicode);\par
\par
    _PyBytesWriter writer;\par
    char *end;\par
\par
    switch (kind) \{\par
    default:\par
        Py_UNREACHABLE();\par
    case PyUnicode_1BYTE_KIND:\par
        end = \ul ucs1lib_utf8_encoder\ulnone (&writer, unicode, data, size,\par
                                   _Py_ERROR_STRICT, NULL);\par
        break;\par
    case PyUnicode_2BYTE_KIND:\par
        end = \ul ucs2lib_utf8_encoder\ulnone (&writer, unicode, data, size,\par
                                   _Py_ERROR_STRICT, NULL);\par
        break;\par
    case PyUnicode_4BYTE_KIND:\par
        end = \ul ucs4lib_utf8_encoder\ulnone (&writer, unicode, data, size,\par
                                   _Py_ERROR_STRICT, NULL);\par
        break;\par
    \}\par
    if (end == NULL) \{\par
        _PyBytesWriter_Dealloc(&writer);\par
        return -1;\par
    \}\par
\par
    const char *start = writer.use_small_buffer ? writer.small_buffer :\par
                    PyBytes_AS_STRING(writer.buffer);\par
    Py_ssize_t len = end - start;\par
\par
    char *cache = PyObject_Malloc(len + 1);\par
    if (cache == NULL) \{\par
        _PyBytesWriter_Dealloc(&writer);\par
        PyErr_NoMemory();\par
        return -1;\par
    \}\par
    _PyUnicode_UTF8(unicode) = cache;\par
    _PyUnicode_UTF8_LENGTH(unicode) = len;\par
    memcpy(cache, start, len);\par
    cache[len] = '\\0';\par
    _PyBytesWriter_Dealloc(&writer);\par
    return 0;\par
\}\par
