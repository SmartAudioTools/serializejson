\b class Encoder(rapidjson.Encoder):\b0\par
\pard\fi-360\li2160     """Class-based dumps()-like functionality."""\par
\par
\pard\fi-1440\li3240     \b def __init__\b0 (self,skip_invalid_keys=False, ensure_ascii=True, indent=None, sort_keys=False, number_mode=None, datetime_mode=None, uuid_mode=None,bytes_mode,write_mode):\par
\pard\fi-360\li2520         """\par
\pard\fi-3060\li5220         Args:\tab\par
            skip_invalid_keys (bool) : whether invalid dict keys will be skipped\par
            ensure_ascii (bool) : \tab whether the output should contain only ASCII characters\par
            indent (int) : \tab indentation width to produce pretty printed JSON\par
            sort_keys (bool) : \tab whether dictionary keys should be sorted alphabetically\par
            number_mode (int) :\tab enable particular behaviors in handling numbers\par
            datetime_mode (int) : \tab how should datetime, time and date instances be handled\par
            uuid_mode (int) : \tab how should UUID instances be handled\par
            write_mode :\tab WM_COMPACT`, that produces the most compact JSON representation\par
\pard\fi-1710\li5220                             WM_PRETTY` it will use RapidJSON's PrettyWriter\par
                            WM_SINGLE_LINE_ARRAY` arrays will be kept on a single line:\par
\pard\fi-3060\li5220             bytes_mode :\tab BM_UTF8\par
\pard\fi-1710\li5220                             BM_NONE\par
\pard\fi-360\li2520         """\par
\pard\fi-1080\li3240         return rapidjson.Encoder.__init__(self,skip_invalid_keys=skip_invalid_keys, ensure_ascii=ensure_ascii, indent=None, sort_keys=sort_keys, number_mode=number_mode, datetime_mode=datetime_mode, uuid_mode=uuid_mode)\par
\pard\fi-360\li2160     \par
\pard\fi-1440\li3240     \b def __call__\b0 (self,obj, stream=None, *, chunk_size=65536):\par
\pard\fi-360\li2520         """\par
\pard\fi-2340\li4500         Args:\tab\par
            obj : \tab The value to be encoded\par
            stream (file-like) :\tab When specified, the encoded result will be written there\par
            chunk_size (int) :\tab write the stream in chunks of this size at a time\par
\pard\fi-720\li2880\par
        Returns:\tab\par
            a string with the JSON encoded value, when stream is None\par
            \par
        Exemples : \par
            >>> encoder = Encoder()\par
            >>> encoder([1,2])\par
            '[1,2]'\par
            >>> f = io.StringIO()\par
            >>> encoder([1,2],f,chunk_size = 65536)\par
            >>> f.seek(0)\par
            >>> f.read()\par
            '[1,2]'\par
\pard\fi-360\li2520         """\par
\pard\fi-1080\li3240         return rapidjson.Encoder.__call__(self,obj,stream = stream ,chunk_size = chunk_size)\par
\pard\fi-360\li2160     \par
    \b def default\b0 (self,obj):  #\cf6  Equivalent au calback "default" qu'on peut passer \'e0 dump ou dumps \par
\pard\fi-450\li2610\cf0         """\par
        If implemented, this method is called whenever the serialization machinery finds a Python object that it does not recognize: if possible, the method should returns a JSON encodable version of the value, otherwise raise a TypeError:\par
\pard\fi-360\li2520\par
        Args:\tab\par
\pard\fi-1170\li3330             obj : the Python object to be encoded\par
\pard\fi-720\li2880\par
        Returns:\par
            a JSON-serializable value\par
\par
        Raises : \par
\pard\fi-1800\li3960             TypeError : the method MUST raise a TypeError if the value is not serializable, otherwisex it will be serialized as None .\par
\pard\fi-720\li2880\par
        Exemples :               \par
            if isinstance(obj, Point):\par
                return \{'x': obj.x, 'y': obj.y\}\par
            else:\par
                raise TypeError('%r is not JSON serializable' % obj)\par
\pard\fi-360\li2520         """\par
\pard\fi-1080\li3240         return rapidjson.Encoder.default(self,obj)\par
\pard\fi-360\li2160     \par
\pard\fi-1440\li2880\b class Decoder(rapidjson.Decoder):\par
\pard\fi-270\li2070\b0     """Class-based loads()-like functionality."""\par
\pard\fi-360\li2160\par
\pard\fi-1440\li3240     \b def __init__\b0 (self,number_mode=None, datetime_mode=None, uuid_mode=None, parse_mode=None):\par
\pard\fi-360\li2520         """   \par
\pard\fi-2700\li4860         Args:\tab\par
            number_mode (int) :\tab Enable particular behaviors in handling numbers\par
            datetime_mode (int) : How should datetime, time and date instances be handled\par
            uuid_mode (int) :\tab How should UUID instances be handled\par
            parse_mode (int) :\tab Whether the parser should allow non-standard JSON extensions\par
\pard\fi-360\li2520         """\par
\pard\fi-1080\li3240         return rapidjson.Decoder.__init__(self,number_mode=number_mode, datetime_mode=datetime_mode, uuid_mode=uuid_mode, parse_mode=parse_mode)\par
\pard\fi-360\li2160     \par
    \b def __call__\b0 (self,json, *, chunk_size=65536):\par
\pard\fi-360\li2520         """\par
\pard\fi-720\li2880         Args:\tab\par
\pard\fi-2970\li5130             json (str,bytes,file-like) :\tab either a str instance, an UTF-8 bytes instance or a file-like stream, containing the JSON to be decoded\par
            chunk_size (int) :\tab in case of a stream, it will be read in chunks of this size\par
\pard\fi-720\li2880\par
        Returns:\tab\par
            a Python value\par
            \par
        Exemples : \par
            >>> decoder = Decoder()\par
            >>> decoder('"\'80 0.50"')\par
            '\'80 0.50'\par
            >>> decoder(b'"\\xe2\\x82\\xac 0.50"')\par
            '\'80 0.50'\par
            >>> decoder(io.StringIO('"\'80 0.50"'))\par
            '\'80 0.50'\par
            >>> decoder(io.BytesIO(b'"\\xe2\\x82\\xac 0.50"'))\par
            '\'80 0.50'\par
\pard\fi-360\li2520         """\par
        return rapidjson.Decoder.__call__(self,json, chunk_size=chunk_size)\par
\pard\fi-360\li2160\par
\cf6     \b def end_array\b0 (self,sequence):\par
\pard\fi-360\li2520\cf0         """This is called, if implemented, when a \cf6 JSON\ul  array \cf0\ulnone has been completely parsed, and \cf6 can be used replace it with an arbitrary different value\cf0 :\par
\par
        Args:\tab\par
\pard\fi-1800\li3960             sequence : an instance implement the mutable sequence protocol\par
\pard\fi-360\li2520             \par
        Returns:\tab\par
            a new value\par
\par
        Exemples : \par
\pard\fi-720\li2880             >>> class TupleDecoder(Decoder):\par
            ...   def end_array(self, a):\par
            ...     return tuple(a)\par
            ...\par
            >>> td = TupleDecoder()\par
            >>> res = td('[\{"one": [1]\}, \{"two":[2,3]\}]')\par
            >>> isinstance(res, tuple)\par
            True\par
            >>> res[0]\par
            \{'one': (1,)\}\par
            >>> res[1]\par
            \{'two': (2, 3)\}\par
\pard\fi-360\li2520         """\par
\pard\fi-360\li2160\par
    \b def end_object\b0 (self,mapping):\par
\pard\fi-360\li2520         """This is called, if implemented, when a JSON object (dictionnaire) has been completely parsed, and can be used to replace it with an arbitrary different value,\cf6  like what can be done with the object_hook argument of the loads() function\cf0 :\par
\par
        Args:\tab\par
\pard\fi-1710\li3870             mapping : an instance implementing the mapping protocol\par
\pard\fi-360\li2520             \par
        Returns:\tab\par
            a new value\par
\par
        Exemples : \par
\pard\fi-720\li2880             >>> class Point(object):\par
            ...   def __init__(self, x, y):\par
            ...     self.x = x\par
            ...     self.y = y\par
            ...   def __repr__(self):\par
            ...     return 'Point(%s, %s)' % (self.x, self.y)\par
            ...\par
            >>> class PointDecoder(Decoder):\par
            ...   def end_object(self, d):\par
            ...     if 'x' in d and 'y' in d:\par
            ...       return Point(d['x'], d['y'])\par
            ...     else:\par
            ...       return d\par
            ...\par
            >>> pd = PointDecoder()\par
            >>> pd('\{"x":1,"y":2\}')\par
            Point(1, 2)\par
\pard\fi-360\li2520         """\par
\pard\fi-1080\li3240         return mapping\par
\pard\fi-360\li2160\par
\cf6     \b def start_object\b0 (self):\par
\pard\fi-450\li2520\cf0         """This method, when implemented, is called whenever a new JSON object (dictionnaire) is found: it must return an instance implementing the mapping protocol.\par
\pard\fi-360\li2520         It can be used to select a different implementation than the standard dict used by default:\par
\par
        Returns:\par
            a mapping instance\par
\par
        Exemples : \par
\pard\fi-720\li2880             >>> from collections import OrderedDict\par
            >>> class OrderedDecoder(Decoder):\par
            ...   def start_object(self):\par
            ...     return OrderedDict()\par
            ...\par
            >>> od = OrderedDecoder()\par
            >>> type(od('\{"foo": "bar"\}'))\par
            <class 'collections.OrderedDict'>\par
\pard\fi-360\li2520         """\par
\pard\fi-1080\li3240         return dict()\par
\pard\fi-360\li2520     \par
\pard\fi-360\li2160\cf6     \b def string\b0 (self,s):\par
\pard\fi-450\li2520\cf0         """This method, when implemented, is called whenever a JSON string has been completely parsed, and can be used to replace it with an arbitrary different value:\par
\pard\fi-360\li2520\par
        Args:\tab\par
            s : a str instance\par
        Returns:\tab\par
            a new value\par
\par
        Exemples : \par
\pard\fi-720\li2880             >>> class SwapStringCase(Decoder):\par
            ...   def string(self, s):\par
            ...     return s.swapcase()\par
            ...\par
            >>> ssc = SwapStringCase()\par
            >>> ssc('"Hello World!"')\par
            'hELLO wORLD!'\par
    \par
            Note that it is called after the recognition of dates and UUIDs, when datetime_mode and/or uuid_mode are specified:\par
    \par
            >>> class DDMMYYYY(Decoder):\par
            ...   def string(self, s):\par
            ...     if len(s) == 8 and s.isdigit():\par
            ...       dd = int(s[:2])\par
            ...       mm = int(s[2:4])\par
            ...       yyyy = int(s[-4:])\par
            ...       return (yyyy, mm, dd)\par
            ...     return s\par
            ...\par
            >>> ddmmyyyy = DDMMYYYY(datetime_mode=DM_ISO8601)\par
            >>> ddmmyyyy('["2017-08-21", "21082017"]')\par
            [datetime.date(2017, 8, 21), (2017, 8, 21)]\par
\pard\fi-360\li2520         """\par
\pard\fi-1080\li3240         return s \b\par
