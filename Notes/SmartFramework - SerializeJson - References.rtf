\b0     def memoize(self, obj):\par
        """Store an object in the memo."""\par
\par
        # The Pickler memo is a dictionary mapping object ids to 2-tuples\par
        # that contain the Unpickler memo key and the object being memoized.\par
        # The memo key is written to the pickle and will become\par
        # the key in the Unpickler's memo.  The object is stored in the\par
        # Pickler memo so that transient objects are kept alive during\par
        # pickling.\par
\par
        # The use of the Unpickler memo length as the memo key is just a\par
        # convention.  The only requirement is that the memo values be unique.\par
        # But there appears no advantage to any other scheme, and this\par
        # scheme allows the Unpickler memo to be implemented as a plain (but\par
        # growable) array, indexed by memo key.\par
        if self.fast:\par
            return\par
        assert id(obj) not in self.memo\par
        idx = len(self.memo)\par
        self.write(self.put(idx))\par
        \ul self.memo[id(obj)] = idx, obj\ulnone\b\par
